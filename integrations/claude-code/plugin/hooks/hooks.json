{
  "description": "RAGbase Shield: block real client names in prompts, deny direct reads of registered dossier folders (built-in tools and other MCP servers), mask registered values left in tool results.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uvx",
            "args": [
              "--from",
              "${CLAUDE_PLUGIN_ROOT}/vendor/ragbase_shield-0.4.0-py3-none-any.whl",
              "ragbase-shield",
              "hook",
              "user-prompt-submit"
            ],
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|LS|LSP|Bash|PowerShell|Monitor|Edit|MultiEdit|Write|NotebookRead|NotebookEdit|Artifact|SendUserFile",
        "hooks": [
          {
            "type": "command",
            "command": "uvx",
            "args": [
              "--from",
              "${CLAUDE_PLUGIN_ROOT}/vendor/ragbase_shield-0.4.0-py3-none-any.whl",
              "ragbase-shield",
              "hook",
              "pre-tool-use"
            ],
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "uvx",
            "args": [
              "--from",
              "${CLAUDE_PLUGIN_ROOT}/vendor/ragbase_shield-0.4.0-py3-none-any.whl",
              "ragbase-shield",
              "hook",
              "pre-tool-use"
            ],
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uvx",
            "args": [
              "--from",
              "${CLAUDE_PLUGIN_ROOT}/vendor/ragbase_shield-0.4.0-py3-none-any.whl",
              "ragbase-shield",
              "hook",
              "post-tool-use"
            ],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
