{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ragbase/ragbase-shield",
  "title": "RAGbase Shield",
  "description": "Local, reversible pseudonymisation of client files for Claude, ChatGPT and Copilot.",
  "version": "0.4.0",
  "websiteUrl": "https://shield.ragbase.ai",
  "repository": {
    "url": "https://github.com/ragbase/ragbase-shield",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/ragbase/ragbase-shield/v0.4.0/integrations/assets/icon-512.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    }
  ],
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "ragbase-shield",
      "version": "0.4.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
