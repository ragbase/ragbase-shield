<?xml version="1.0" encoding="utf-8"?>
<!--
  RAGbase Shield, per-user Windows installer (WiX Toolset 5, packaging/DESIGN.md section 7.1).

  - Scope="perUser": no UAC prompt, no administrator. Everything goes into the user's own folders:
    program in %LOCALAPPDATA%\Programs\RAGbase Shield, Start menu shortcut, HKCU keys.
  - The data folder %LOCALAPPDATA%\ragbase-shield (vaults, key, token) is never part of this package and is
    never removed by it.
  - MajorUpgrade: a newer .msi removes the old product first. The old product's ShieldUnregister is skipped
    (UPGRADINGPRODUCTCODE), so the Run key and extras\ survive; the new ShieldRegister rewrites install.json.
  - Custom actions run our own runtime ("RAGbase Shield.exe" = pythonw.exe, no console): no custom-action DLL,
    no PowerShell, no network. Flags -E -s -P -X utf8 (README "Interpreter flags"). Their working folder is
    %LOCALAPPDATA%, never the app folder (a process with its working folder there would keep it from being
    removed at uninstall).
  - ShieldStopEarly (review 2026-11-03): InstallValidate lists every process that holds a file to replace or
    remove, and it runs BEFORE the deferred actions. The running supervisor and Desk were listed on every update
    and removal ("files in use", 4 processes in the upgrade log of the first build): with a window, that is a
    "fichiers en cours d'utilisation" dialog for the user. So an immediate action stops the installed service
    before InstallValidate, on an update (WIX_UPGRADE_DETECTED) or when the product is already installed (a
    removal, or the same package run again). On a first install nothing runs. ShieldStop stays as the deferred
    safety net.
  - Components.wxs is generated by gen_components.py from the staged payload (one component per folder,
    HKCU KeyPath, RemoveFolder, *.pyc clean-up of every __pycache__ folder Python writes at first start).

  Variables (wix build -d): Version, ProductCode, UpgradeCode, ShortcutGuid, PayloadDir. build_msi.ps1 passes
  them from msi_vars.json (stage_payload.py). Codepage 1252 holds every French character used here.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="RAGbase Shield" Manufacturer="RAGbase" Version="$(var.Version)" Scope="perUser"
           ProductCode="$(var.ProductCode)" UpgradeCode="$(var.UpgradeCode)" Language="1036" Codepage="1252"
           InstallerVersion="500" Compressed="yes">

    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="Une version plus récente de RAGbase Shield est déjà installée. (A newer version of RAGbase Shield is already installed.)" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="RAGbase Shield" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="$(var.ShortcutGuid)">
        <Shortcut Id="ShieldShortcut" Name="RAGbase Shield" Description="Démarrer Shield Desk (Start Shield Desk)"
                  Target="[INSTALLFOLDER]runtime\RAGbase Shield.exe"
                  Arguments="-E -s -P -X utf8 -m ragbase_shield service start"
                  WorkingDirectory="LocalAppDataFolder" Icon="shield.ico" />
        <RegistryValue Root="HKCU" Key="Software\RAGbase\Shield" Name="shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Icon Id="shield.ico" SourceFile="$(var.PayloadDir)\icons\shield.ico" />
    <Property Id="ARPPRODUCTICON" Value="shield.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPURLINFOABOUT" Value="https://ragbase.ai" />
    <Property Id="ARPCOMMENTS" Value="Vos dossiers et vos coffres restent dans %LOCALAPPDATA%\ragbase-shield après la désinstallation." />
    <!-- No Restart Manager: it would send WM_CLOSE to the tray window (that is "Quitter"). ShieldStop stops the
         service before any file is replaced. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    <!-- Never a reboot, never a reboot prompt (review 2026-11-03). When an AI app still runs the MCP server from
         runtime\, python.exe and its DLLs are in use: without this, a silent install or removal (/qn, the IT
         commands) REBOOTS the computer at once (REBOOT=Prompt with no UI), and the Settings > Apps flow asks
         "redémarrer maintenant ?". With it, msiexec returns 3010 and Windows finishes the file changes at the next
         reboot (checked: test_install.ps1, W8b). -->
    <Property Id="REBOOT" Value="ReallySuppress" />

    <Feature Id="Main" Title="RAGbase Shield" Level="1">
      <ComponentGroupRef Id="Payload" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <CustomAction Id="ShieldRegister" Directory="LocalAppDataFolder" Execute="deferred" Impersonate="yes" Return="ignore"
                  ExeCommand="&quot;[INSTALLFOLDER]runtime\RAGbase Shield.exe&quot; -E -s -P -X utf8 -m ragbase_shield service install --no-start" />
    <CustomAction Id="ShieldStart" Directory="LocalAppDataFolder" Execute="immediate" Return="asyncNoWait"
                  ExeCommand="&quot;[INSTALLFOLDER]runtime\RAGbase Shield.exe&quot; -E -s -P -X utf8 -m ragbase_shield service start" />
    <CustomAction Id="ShieldStopEarly" Directory="LocalAppDataFolder" Execute="immediate" Return="ignore"
                  ExeCommand="&quot;[INSTALLFOLDER]runtime\RAGbase Shield.exe&quot; -E -s -P -X utf8 -m ragbase_shield service stop --quiet" />
    <CustomAction Id="ShieldStop" Directory="LocalAppDataFolder" Execute="deferred" Impersonate="yes" Return="ignore"
                  ExeCommand="&quot;[INSTALLFOLDER]runtime\RAGbase Shield.exe&quot; -E -s -P -X utf8 -m ragbase_shield service stop --quiet" />
    <CustomAction Id="ShieldUnregister" Directory="LocalAppDataFolder" Execute="deferred" Impersonate="yes" Return="ignore"
                  ExeCommand="&quot;[INSTALLFOLDER]runtime\RAGbase Shield.exe&quot; -E -s -P -X utf8 -m ragbase_shield service uninstall --quiet --purge-extras" />

    <InstallExecuteSequence>
      <Custom Action="ShieldStopEarly" Before="InstallValidate" Condition="Installed OR WIX_UPGRADE_DETECTED" />
      <Custom Action="ShieldStop" Before="ShieldUnregister" Condition="Installed" />
      <Custom Action="ShieldUnregister" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="ShieldRegister" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="ShieldStart" After="InstallFinalize" Condition="NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
